# Claude — drives GEO enrichment (FAQs, rewritten about, optimized meta).
# Without this, the publish workflow still runs but skips enrichment.
ANTHROPIC_API_KEY=

# Public app URL (used in metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hosted-site subdomain config.
# SITE_APEX_HOSTS: comma-separated list of apex hosts that should NOT be
# treated as a templated subdomain (proxy passthrough). The first one is
# also the canonical apex used as the fallback for SITE_PUBLIC_APEX.
SITE_APEX_HOSTS=shorobik.com,localhost:3000,localhost
# Where the public-facing templated sites live: <subdomain>.<apex>.
SITE_PUBLIC_APEX=shorobik.com
# Mirror for client-side display.
NEXT_PUBLIC_SITE_APEX=shorobik.com

# Vercel Blob — required: stores published site JSON + workflow run status.
# Provision via Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=

# Google Maps — enable "Maps JavaScript API" + "Directions API" on the key.
# Map ID is needed for Advanced Markers (create one in Google Cloud → Map Management).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
